# Banco de dados: PostgreSQL em todos os ambientes (ver docs/DEPLOY.md).
# Dev local via docker-compose (docker compose up -d) ou branch dev do Neon.
DATABASE_URL="postgresql://tdm:tdm@localhost:5432/tdm_sorteios"

# Segredo para assinar o token de sessão (gere um: openssl rand -base64 32)
AUTH_SECRET="troque-por-um-segredo-forte"

# URL pública do site (usada nos retornos de pagamento e webhooks)
NEXT_PUBLIC_URL="http://localhost:3000"

# PagBank (ver docs/DEPLOY.md, seção 4). Sem essas variáveis o app funciona,
# mas as compras ficam indisponíveis com um aviso.
# PAGBANK_ENV: "sandbox" ou "production"
PAGBANK_ENV="sandbox"
# Token Bearer das APIs (Orders e Assinaturas)
PAGBANK_TOKEN=""
# Chave pública para criptografar o cartão no navegador (SDK oficial)
NEXT_PUBLIC_PAGBANK_PUBLIC_KEY=""
# Lembre de cadastrar NEXT_PUBLIC_URL + /api/webhooks/pagbank como URL de
# notificação na conta PagBank (pedidos e assinaturas).
